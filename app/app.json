{
  "expo": {
    "name": "ワタシアター",
    "slug": "watashiater",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "watashiater",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hohoemirabo.watashiater",
      "adaptiveIcon": {
        "backgroundColor": "#FFE4F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "ワタシアター",
      "lang": "ja",
      "description": "じぶんの博物館を つくりましょう",
      "themeColor": "#FFD6E8"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFD6E8"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "声を録音するためにマイクを使います。",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "思い出の写真を選ぶために写真フォルダーを使います。"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05b67741-c0d4-4d31-a94f-3d2512dd9713"
      }
    },
    "owner": "hohoemirabo"
  }
}
