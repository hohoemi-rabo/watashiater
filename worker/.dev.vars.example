# ローカル開発用（wrangler dev が読み込む）。このファイルをコピーして .dev.vars を作る。
# 本番は wrangler secret put で設定する:
#   wrangler secret put GEMINI_API_KEY
#   wrangler secret put SUPABASE_SECRET_KEY
#   wrangler secret put SIGNING_SECRET
# SUPABASE_URL は秘密ではないので wrangler.jsonc の vars 側にある。
# SUPABASE_JWT_SECRET は存在しない：JWT は Supabase の公開 JWKS（ES256）で検証する（docs/07 メモ参照）

# Google AI Studio (https://aistudio.google.com/apikey) で発行
GEMINI_API_KEY=

# Supabase ダッシュボード → Project Settings → API Keys の secret キー（sb_secret_...）
SUPABASE_SECRET_KEY=

# メディア署名URL用の HMAC 秘密鍵。生成例: openssl rand -base64 32
SIGNING_SECRET=
